# Local defaults. No credentials or private tokens belong in NEXT_PUBLIC_*.
ADMIN_API_PORT=3010
ADMIN_WEB_PORT=3100
ADMIN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
# Set only exact addresses of managed reverse proxies that overwrite forwarding headers.
ADMIN_TRUSTED_PROXIES=
# Leave empty until a hosted HTTPS collector exists. GitHub Pages disables telemetry without it.
NEXT_PUBLIC_TELEMETRY_URL=
